<% layout("layouts/boilerplate") %>
<h2 class="col-6 offset-3 mb-3">Login to Explore Wanderlust!</h2>
<div class="row">
  <div class="col-6 offset-3">
    <form action="/login" method="post" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input
          name="username"
          type="text"
          id="username"
          class="form-control"
          required
        />
      </div>

      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input
          name="password"
          type="password"
          id="password"
          class="form-control"
          required
        />
      </div>
      <button class="btn btn-dark create-btn">Login</button>
    </form>
  </div>
</div>
